# react-scripts@5.0.1 peer-requires typescript ^3 || ^4, but this project runs
# typescript 5.x. CRA is unmaintained and the range is simply stale — TS 5 works
# fine with it. Pinning this here so `npm install` succeeds on a fresh clone
# without every developer having to remember --legacy-peer-deps.
legacy-peer-deps=true
